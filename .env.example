# UniPath AI configuration. Copy to `.env` (same folder) and fill in values.
# `.env` is git-ignored: never commit real credentials. Use separate values for
# development and production, and rotate any value that is ever exposed.

# --- Database (required) ---
# `pnpm db:local` starts a zero-install Postgres on 5433 using these defaults.
# With Docker instead: `docker compose up -d db` (same URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
# Hosted Postgres (Supabase): add ?sslmode=require&uselibpqcompat=true to the URL,
# or set DATABASE_CA_CERT to the provider's CA certificate (PEM) to also verify it.
# DATABASE_CA_CERT=

# --- Accounts: sign-in and registration (built in) ---
# Email + password, one-time email codes and Google, all handled by the API.
# Email codes (sign-up verification, code sign-in, password reset) need SMTP.
# Without it, development writes each code to the API server log instead, and
# production turns email codes off (Google and existing passwords still work).
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465   # any SMTP provider
# EMAIL_FROM="UniPath AI <no-reply@your-domain.example>"
# Google: create an OAuth client (type "Web application") in Google Cloud
# Console > APIs & Services > Credentials, and add the redirect URI
# <your site origin>/api/auth/google/callback, e.g.
# http://localhost:5173/api/auth/google/callback for local development.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Servers ---
PORT=8080                        # API server (also serves the built web app in production)
WEB_PORT=5173                    # Vite dev server; proxies /api to PORT
# NODE_ENV=production            # set on production hosts
# APP_ORIGIN=https://your-domain.example   # public site origin (required in production)
# UNIPATH_TRUSTED_ORIGINS=       # extra HTTPS origins, comma-separated
# TRUST_PROXY=1                  # when behind Nginx or a PaaS load balancer
# PROXY_SHARED_SECRET=           # same value as the Cloudflare Pages project; see docs/deployment.md
# VITE_PUBLIC_APP_URL=           # production URL for the admin "open published app" link
# LOG_LEVEL=info
# SLOW_REQUEST_MS=1500           # log a warning for requests slower than this
# DB_PORT=5433                   # port used by `pnpm db:local`

# --- File storage ---
# Private files (verified logos, student documents). Default: ./.data/storage
# STORAGE_DIR=
# DOCUMENT_MAX_BYTES=10485760     # per-file upload limit (10 MB)

# --- AI assistant (optional; shows prepared examples until set) ---
# OPENAI_API_KEY=                # server-side only
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=45000
# AI_DAILY_LIMIT_FREE=15

# --- Administration ---
# UNIPATH_ADMIN_SETUP_USER_ID=   # account id (shown on /admin/setup) allowed to complete one-time admin setup

# --- Optional data and job providers ---
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# COLLEGE_SCORECARD_API_KEY=     # directory import scripts only

# --- Payments: intentionally not connected ---
# Checkout stays closed until the owner approves live payments and the full
# billing lifecycle (webhook signatures, renewals, refunds) has been tested.

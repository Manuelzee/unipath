{
  "name": "unipath-ai",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm/')){console.error('Use pnpm: corepack enable, then pnpm install');process.exit(1)}\"",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/unipath-ai run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/unipath-ai run dev",
    "db:local": "node tools/dev-database.mjs",
    "db:check": "pnpm --filter @workspace/db run check",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/api-server run seed",
    "codegen": "pnpm --filter @workspace/api-spec run codegen",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "test": "pnpm --filter @workspace/api-server run test:unit",
    "test:integration": "pnpm --filter @workspace/api-server run test:integration",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./apps/**\" --if-present run typecheck"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}

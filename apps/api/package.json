{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env ./dist/index.mjs",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/loadTuitionSnapshots.ts",
    "sync:directory": "tsx --env-file-if-exists=../../.env src/scripts/syncDirectory.ts",
    "import:international": "tsx --env-file-if-exists=../../.env src/scripts/importInternationalDirectory.ts",
    "import:verified-facts": "tsx --env-file-if-exists=../../.env src/scripts/importVerifiedInstitutionFacts.ts",
    "script": "tsx --env-file-if-exists=../../.env",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "tsx src/scripts/tests/testBlueprintLogic.ts",
    "test:integration": "tsx --env-file-if-exists=../../.env src/scripts/tests/testWorkspaceIsolation.ts && tsx --env-file-if-exists=../../.env src/scripts/tests/testAuth.ts && tsx --env-file-if-exists=../../.env src/scripts/tests/testChat.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "robots-parser": "^3.0.1",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
